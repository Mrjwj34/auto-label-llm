{
  "name": "test_real_stack",
  "description": "Integration-testing profile for connecting a real vLLM/SAM/worker stack later.",
  "backend": {
    "APP_PROFILE": "test_real_stack",
    "ANNOTATION_BACKEND": "openai_compatible",
    "VLLM_BASE_URL": "http://127.0.0.1:8001",
    "VLLM_MODEL_NAME": "qwen3-vl-4b",
    "LLM_REQUEST_TIMEOUT_SECONDS": "30",
    "LLM_MAX_RETRIES": "1",
    "LLM_MAX_TOKENS": "2048",
    "CORS_ALLOW_ORIGINS": "[\"http://localhost:5173\", \"http://127.0.0.1:5173\"]"
  },
  "frontend": {
    "VITE_API_BASE_URL": "http://127.0.0.1:8000",
    "VITE_APP_PROFILE": "test_real_stack"
  },
  "project_defaults": {
    "llm": {
      "base_model": "qwen3-vl-4b",
      "auto_order": ["4b", "8b", "2b"],
      "max_tokens": 2048
    },
    "sam": {
      "checkpoint": "sam2_hiera_base_plus",
      "device": "cuda",
      "multimask_output": true
    },
    "postprocess": {
      "enable_close": true,
      "close_kernel": 5,
      "enable_dp_simplify": true,
      "epsilon_ratio": 0.003,
      "min_area_ratio": 0.0004
    },
    "quality": {
      "enable": true,
      "threshold_review": 0.6,
      "threshold_ok": 0.84,
      "use_llm_confidence": true,
      "use_sam_score": true,
      "enable_consistency_check": true
    },
    "evaluation": {
      "split": "val",
      "iou_threshold": 0.55,
      "max_samples": 200
    }
  }
}
